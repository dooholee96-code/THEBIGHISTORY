{
  "name": "big-history-timeline",
  "version": "0.1.0",
  "private": true,
  "description": "빅 히스토리 스타일 통합 연표 — 왕조·국가사와 주제사를 한 시간축에서 비교하는 정적 웹앱",
  "scripts": {
    "validate": "node scripts/validate.js",
    "fix": "node scripts/validate.js --fix",
    "bundle": "node scripts/bundle.js",
    "build": "npm run validate && npm run pages && npm run stamp && npm run bundle",
    "serve": "npx --yes serve -l 5173 .",
    "serve:python": "python3 -m http.server 5173",
    "stamp": "node scripts/stamp.js",
    "sources:match": "node scripts/match-wikidata.js",
    "sources:candidates": "node scripts/candidates-wikidata.js",
    "sources:apply": "node scripts/apply-wikidata.js",
    "pages": "node scripts/pages.js"
  },
  "keywords": [
    "timeline",
    "history",
    "big-history",
    "wikidata",
    "open-data"
  ],
  "license": "MIT"
}
