{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "index.schema.json",
  "title": "빅 히스토리 연표 매니페스트",
  "description": "data/index.json. 어떤 데이터 파일이 존재하고 각각 어떤 트랙/카테고리/표시이름/색상에 속하는지 등록한다.",
  "type": "object",
  "required": ["schema_version", "tracks", "datasets", "eras"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "order": { "type": "integer" }
        }
      }
    },
    "eras": {
      "type": "array",
      "description": "연표를 나누는 시대 구간. 화면의 시대 칩·섹션·배경 팔레트가 모두 여기서 만들어진다.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "start_year", "end_year"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "range": { "type": "string", "description": "칩·제목 옆에 표시할 연도 범위 문구" },
          "start_year": { "type": "integer" },
          "end_year": { "type": "integer" },
          "art": { "type": "string", "description": "이 시대에 들어갈 삽화의 의도(자리표시자 라벨)" },
          "day": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } },
          "day_blob": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } },
          "night": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } },
          "night_blob": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } }
        }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "description": "새 국가/카테고리 추가 = data/ 에 JSON 파일 하나 + 여기에 항목 하나 추가.",
      "items": {
        "type": "object",
        "required": ["id", "file", "track", "category", "subcategory", "label", "color"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "file": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.json$" },
          "track": {
            "type": "string",
            "description": "tracks[].id 중 하나. 기본값은 nation(왕조·국가사) / theme(주제사).",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "category": { "type": "string", "minLength": 1 },
          "subcategory": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "region": { "type": "string" },
          "order": { "type": "integer" },
          "hidden_by_default": { "type": "boolean" }
        }
      }
    }
  }
}
