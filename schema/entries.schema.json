{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entries.schema.json",
  "title": "빅 히스토리 연표 데이터 파일",
  "description": "/data/*.json 한 개의 구조. 항목(entry) 배열을 담는다.",
  "type": "object",
  "required": ["entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "dataset": {
      "type": "string",
      "description": "data/index.json 의 datasets[].id 와 일치해야 한다.",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id",
        "category",
        "subcategory",
        "title",
        "region",
        "start_year",
        "end_year",
        "description",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "전체 데이터에서 유일한 ID. 소문자/숫자/하이픈만 사용.",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 2
        },
        "category": {
          "type": "string",
          "description": "대분류. 예: 왕조사, 과학사",
          "minLength": 1
        },
        "subcategory": {
          "type": "string",
          "description": "국가명 또는 세부분류. 예: 한국, 중국, 음악",
          "minLength": 1
        },
        "title": { "type": "string", "minLength": 1 },
        "region": {
          "type": "string",
          "description": "대륙/지역. 예: 동아시아, 유럽, 세계",
          "minLength": 1
        },
        "start_year": {
          "type": "integer",
          "description": "시작 연도. 기원전은 음수(예: 기원전 2333년 => -2333). 연도 0은 사용하지 않는다.",
          "minimum": -50000,
          "maximum": 2200
        },
        "end_year": {
          "type": "integer",
          "description": "종료 연도. 단일 사건이면 start_year 와 같은 값을 넣는다.",
          "minimum": -50000,
          "maximum": 2200
        },
        "era_note": {
          "type": "string",
          "description": "BC/AD 등 표기 보조 설명. 비워두면 검증 스크립트가 자동으로 채운다."
        },
        "description": { "type": "string", "minLength": 1 },
        "summary": {
          "type": "string",
          "description": "연표 막대에 함께 표시할 한 줄 요약(선택). 비워두면 description 의 첫 문장을 줄여서 자동으로 만든다.",
          "minLength": 1,
          "maxLength": 60
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "sources": {
          "type": "array",
          "description": "이 항목의 연도·내용을 실제로 확인한 자료만 적는다. 가능하면 확인 가능한 URL 또는 '저자, 책이름, 쪽수' 처럼 되짚을 수 있는 형태로. 확인하지 않았다면 비워 둔다(빈 배열 = 출처 미확인). status 를 reviewed 로 올리려면 최소 1개가 있어야 한다.",
          "items": { "type": "string", "minLength": 1 }
        },
        "dating_note": {
          "type": "string",
          "description": "연대의 근거나 한계를 적는 자리. 문헌 전승 연대, 추정치, 학설이 갈리는 연대라면 여기에 밝힌다.",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "description": "draft = 검토 전(출처 미확인), reviewed = 자료로 직접 확인함(sources 필수)",
          "enum": ["draft", "reviewed"]
        },
        "note": {
          "type": "string",
          "description": "검토 메모 등 자유 기입란(선택)."
        }
      }
    }
  }
}
